{
  "name": "airpaymoney",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "test:health": "npx playwright test tests/health.spec.ts --reporter=line,allure-playwright",
    "test:life": "npx playwright test tests/lifeterm.spec.ts --reporter=line,allure-playwright",
    "allure:generate": "npx allure generate allure-results --clean -o allure-report",
    "allure:open": "npx allure open allure-report",
    "test:allure": "npm run test && npm run allure:generate && npm run allure:open",
    "test:allure:health": "npx playwright test tests/health.spec.ts --headed; npm run allure:generate; npm run allure:open",
    "test:health:headed": "npx playwright test tests/health.spec.ts --headed --workers=1",
    "test:lifeterm": "npx playwright test tests/lifeterm.spec.ts --headed; npm run allure:generate; npm run allure:open",
    "test:lifeterm:headed": "npx playwright test tests/lifeterm.spec.ts --headed --workers=1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.9.5",
    "allure-playwright": "^3.7.2",
    "xlsx": "^0.18.5"
  },
  "dependencies": {
    "pdf-visual-comparer": "^2.0.2"
  }
}
